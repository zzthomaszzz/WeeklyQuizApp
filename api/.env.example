DATABASE_URL=postgresql+asyncpg://username:password@hostname/database

TEST_DATABASE_URL=postgresql+asyncpg://username:password@hostname/database



# Set a random secret of at least 32 characters; keep it out of Git.
SESSION_SECRET=
# false for local HTTP only; true for HTTPS deployment.
COOKIE_SECURE=false
# Add the exact deployed frontend origin when deploying (JSON array).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
